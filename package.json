{
  "name": "routinely",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @routinely/shared build && pnpm -r --parallel dev",
    "build": "pnpm --filter @routinely/shared build && pnpm -r --filter '!@routinely/shared' build",
    "lint": "eslint . && pnpm --filter @routinely/web lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @routinely/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @routinely/api test:e2e",
    "prepare": "husky",
    "db:up": "docker compose up -d db",
    "eval:ai": "pnpm --filter @routinely/api eval:ai",
    "demo:reset": "pnpm --filter @routinely/api demo:reset",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
