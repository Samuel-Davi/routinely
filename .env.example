# ─── IA ───────────────────────────────────────────────────────────────────────
# Provedor: gemini | anthropic | ollama
LLM_PROVIDER=gemini
# Chave do Google AI Studio (free tier, sem billing): https://aistudio.google.com/apikey
# Sem chave o app funciona com o fallback heurístico ("rotina gerada sem IA").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo usado no retry quando a resposta falha na validação
GEMINI_RETRY_MODEL=gemini-3.6-flash
# Opcional (provedores ainda são stubs documentados)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Limites das chamadas de IA
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_ATTEMPTS=3
AI_RATE_LIMIT_TTL_MS=60000
AI_RATE_LIMIT_MAX=20

# ─── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=routinely
POSTGRES_PASSWORD=routinely
POSTGRES_DB=routinely
POSTGRES_PORT=5432
# Usadas ao rodar a API fora do Docker (pnpm dev). No docker compose a API usa o host "db".
DATABASE_URL=postgresql://routinely:routinely@localhost:5432/routinely?schema=public
DIRECT_URL=postgresql://routinely:routinely@localhost:5432/routinely?schema=public
# Banco usado pelos testes e2e da API
TEST_DATABASE_URL=postgresql://routinely:routinely@localhost:5432/routinely_test?schema=public

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=America/Manaus

# ─── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=3000
# URL da API vista pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Manaus
