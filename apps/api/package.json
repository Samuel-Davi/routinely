{
  "name": "@routinely/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "dotenv -e ../../.env -- jest --config ./test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "tasks:link": "dotenv -e ../../.env -- node scripts/link-tasks.mjs",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed",
    "postinstall": "prisma generate",
    "eval:ai": "dotenv -e ../../.env -- tsx eval/run.ts",
    "claim-owner": "dotenv -e ../../.env -- node scripts/claim-owner.mjs",
    "demo:reset": "nest build && dotenv -e ../../.env -- node dist/demo/demo.cli.js"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@google/genai": "^3.0.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "@routinely/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
